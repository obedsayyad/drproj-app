# Names only; supply real values out-of-band (never commit). Mode 0600 on the host.
SUPABASE_APP_URL=
SUPABASE_OPS_URL=
SUPABASE_BACKUP_URL=
SUPABASE_MIGRATION_URL=
SUPABASE_RESTORE_URL=
DEMO_MODE=
# Relief app (apps/relief); defaults in apps/relief/README.md
APP_PORT=
APP_METRICS_PORT=
APP_TLS_CERT_FILE=
APP_TLS_KEY_FILE=
# Integer 1..5 (default 2); any other value makes the app refuse to start.
APP_DB_POOL_MAX=
INSTANCE_ID=
# Display-only identity (role primary|warm|elastic; provider self_hosted|digitalocean|linode); the app role writes these.
INSTANCE_ROLE=
INSTANCE_PROVIDER=
INSTANCE_REGION=
INSTANCE_LABEL=
APP_VERSION=
RATE_LIMIT_EXEMPT_IPS=
TRUSTED_PROXY_IPS=
# Local real-Postgres integration tests only (not Supabase)
TEST_DATABASE_URL=
