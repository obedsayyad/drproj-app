# Names only; supply real values out-of-band (never commit). File mode 0600 inside a 0700 directory.
RELIEF_IMAGE=
SUPABASE_APP_URL=
DEMO_MODE=
# CPU workers for the demo workload (1..4); the app role sets one per vCPU.
DEMO_MAX_CPU_WORKERS=
APP_DB_POOL_MAX=
INSTANCE_ID=
APP_VERSION=
RATE_LIMIT_EXEMPT_IPS=
TRUSTED_PROXY_IPS=
# Published host ports (defaults 8443 / 9464 / 9100)
APP_PORT=
APP_METRICS_PORT=
NODE_EXPORTER_PORT=
# Plain-text source of the node_exporter basic-auth hash; also held by the Prometheus scrape config.
NODE_EXPORTER_BASIC_AUTH_PASSWORD=
